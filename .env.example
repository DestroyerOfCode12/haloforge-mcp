# HaloForge MCP configuration
# Copy this file to .env (git ignored) and fill in your values. Never commit secrets.

# ===== One instance (original variables) =====
HALO_BASE_URL=https://yourcompany.haloitsm.com
HALO_CLIENT_ID=your_client_id_here
HALO_CLIENT_SECRET=your_client_secret_here

# ===== Or several instances (takes precedence when set) =====
# HALO_INSTANCES=trial,prod
# HALO_TRIAL_BASE_URL=https://yourcompany-trial.haloitsm.com
# HALO_TRIAL_CLIENT_ID=
# HALO_TRIAL_CLIENT_SECRET=
# HALO_TRIAL_MODE=write
# HALO_PROD_BASE_URL=https://yourcompany.haloitsm.com
# HALO_PROD_CLIENT_ID=
# HALO_PROD_CLIENT_SECRET=
# HALO_PROD_MODE=read
# HALO_DEFAULT_INSTANCE=trial

# ===== Safety (global defaults; per instance values override) =====
# read (default) | write | full
HALO_MODE=read
# Delete tools are only registered when this is false and an instance is in full mode
HALO_DISABLE_DELETE=true
# Optional comma separated resources that may be written
# HALO_WRITE_ALLOWLIST=Report,DashboardLinks,Lookup

# ===== Audit and output =====
# HALO_AUDIT_LOG=logs/audit.jsonl
# HALO_MAX_OUTPUT_CHARS=80000
# HALO_MAX_RETRIES=3

# ===== Network =====
# HTTPS_PROXY=http://proxy.example:3128
# NO_PROXY=localhost

# ===== Transport =====
# "stdio" for Claude Desktop and Claude Code, "http" for Docker or remote
MCP_TRANSPORT=stdio
# Port for HTTP mode (default: 3000)
MCP_PORT=3000

# ===== HTTP authentication mode =====
# "env"   Client ID and Secret from the variables above (default)
# "oauth" Credentials passed via the Claude connector UI (only needs HALO_BASE_URL)
MCP_AUTH=env
# Public URL where the server is reachable (OAuth mode only)
# MCP_PUBLIC_URL=https://your-public-url.example.com

# ===== Optional =====
HALO_SCOPE=all
HALO_TENANT=
LOG_LEVEL=info
