{
  "name": "haloforge-mcp",
  "version": "2.0.0",
  "description": "MCP server for HaloITSM that can read and safely configure everything an administrator can configure. Based on halo-itsm-mcp (MIT).",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "haloforge-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "clean": "rm -rf dist",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "RUN_INTEGRATION=1 vitest run tests/integration",
    "coverage-matrix": "tsx scripts/coverage-matrix.ts",
    "prepare": "npm run build"
  },
  "keywords": [
    "mcp",
    "halo",
    "haloitsm",
    "itsm",
    "service-desk",
    "configuration",
    "ai"
  ],
  "author": "HaloForge MCP contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DestroyerOfCode12/haloforge-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/DestroyerOfCode12/haloforge-mcp/issues"
  },
  "homepage": "https://github.com/DestroyerOfCode12/haloforge-mcp#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "undici": "^6.29.1",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "eslint": "^9.39.5",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.71.2",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
